{
    "name": "nawasara/asn-portal",
    "description": "Backend for the ASN account portal (asn.ponorogo.go.id). Account endpoints behind the employee-realm JWT for every civil servant, public content (app catalog, help, versioned legal documents), and the policy that decides which Keycloak required action a portal may start.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "asn",
        "account",
        "keycloak",
        "portal"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/asn-portal/issues",
        "source": "https://github.com/nawasara/asn-portal"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\AsnPortal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nawasara\\AsnPortal\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.9",
        "livewire/livewire": "^3.0",
        "nawasara/api": "*",
        "nawasara/ui": "*",
        "nawasara/auth-primitives": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\AsnPortal\\AsnPortalServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
